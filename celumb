  <div id="adq-modal" class="modal-backdrop" role="presentation">
    <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="adq-title">
      <div class="modal-panel__head">
        <div>
          <p class="modal-eyebrow">Tipo de ingreso · Adquisición</p>
          <h2 id="adq-title" class="modal-panel__title">Registrar adquisición</h2>
          <p class="muted" style="margin:0.25rem 0 0">Compra/Ingreso de mercancía — No. Stock sugerido MBC20 (editable).</p>
        </div>
        <button type="button" class="modal-close" data-close-adq aria-label="Cerrar">×</button>
      </div>
      <form id="adq-form" onsubmit="return false" novalidate>
        <div class="form-grid">
          <div class="field"><label>Fecha</label><input type="date" value="2026-10-18" id="adq-fecha" /></div>
          <div class="field">
            <label>No. Stock</label>
            <input id="adq-stock" value="MBC20" />
            <p class="field-hint">Sugerido: MBC20 — puedes editarlo</p>
          </div>
          <div class="field"><label>Costo</label><input id="adq-cost" type="number" min="0" step="1" value="" /></div>
          <div class="field"><label>Precio inicial sugerido</label><input id="adq-price" type="number" min="0" step="1" value="" /></div>
          <div class="field">
            <label>Margen</label>
            <input id="adq-margin" class="input-locked" readonly value="—" />
            <p class="field-hint">Precio − costo (se guarda con el equipo)</p>
          </div>
          <fieldset class="field field-span"><legend>Incluye cargador</legend>
            <div class="choice-row">
              <label class="choice"><input type="radio" name="chg" checked /> Si</label>
              <label class="choice"><input type="radio" name="chg" /> No</label>
              <label class="choice"><input type="radio" name="chg" /> Se incluira en venta</label>
            </div>
          </fieldset>
          <div class="field"><label>Marca</label><input placeholder="Samsung" value="" /></div>
          <div class="field"><label>Modelo</label><input placeholder="Galaxy A07" value="" /></div>
          <div class="field"><label>IMEI</label><input placeholder="Opcional" value="" /></div>
          <fieldset class="field field-span"><legend>Compañia</legend>
            <div class="choice-row">
              <label class="choice"><input type="radio" name="cia" checked data-cia="Liberado" /> Liberado</label>
              <label class="choice"><input type="radio" name="cia" data-cia="Telcel" /> Telcel</label>
              <label class="choice"><input type="radio" name="cia" data-cia="otra" /> Otra</label>
            </div>
            <input class="carrier-other" id="cia-other" placeholder="Escribe la compañía" />
          </fieldset>
          <fieldset class="field field-span"><legend>Condicion estetica</legend>
            <div class="choice-row">
              <label class="choice"><input type="radio" name="cond" /> AA Nuevo</label>
              <label class="choice"><input type="radio" name="cond" checked /> A Bueno (9-10)</label>
              <label class="choice"><input type="radio" name="cond" /> B Regular (8)</label>
              <label class="choice"><input type="radio" name="cond" /> C Con marcas de uso (7)</label>
            </div>
          </fieldset>
          <div class="field"><label>RAM</label><input placeholder="4 / 4 + 1" value="" /></div>
          <div class="field"><label>Almacenamiento</label><input placeholder="128" value="" /></div>
          <div class="field"><label>% de batería</label><input type="number" min="0" max="100" placeholder="85" value="" /></div>
          <div class="field field-span"><label>Comentarios</label><textarea></textarea></div>
        </div>
        <div class="form-actions" style="margin-top:1rem">
          <button type="submit" class="btn btn-primary">Registrar adquisición</button>
          <button type="button" class="btn btn-solid" data-close-adq>Cancelar</button>
        </div>
        <p class="form-status muted" id="adq-status"></p>
      </form>
    </div>
  </div>

  <script>
    const EXISTING_STOCK = new Set(["MBC01", "MBC02", "MBC03", "MBC04", "MBC05", "MBC06", "MBC07", "MBC08", "MBC09", "MBC10", "MBC11", "MBC12", "MBC13", "MBC14", "MBC15", "MBC16", "MBC17", "MBC18", "MBC19"]);
    function showView(id) {
      document.querySelectorAll(".view").forEach((el) => el.classList.toggle("is-active", el.id === "view-" + id));
      document.querySelectorAll("[data-nav]").forEach((el) => {
        if (el.classList.contains("site-nav__link")) {
          el.classList.toggle("is-active", el.getAttribute("data-nav") === id);
        }
      });
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
    document.querySelectorAll("[data-nav]").forEach((el) => {
      el.addEventListener("click", (e) => { e.preventDefault(); showView(el.getAttribute("data-nav")); });
    });
    const modal = document.getElementById("adq-modal");
    document.querySelectorAll("[data-open-adq]").forEach((btn) => {
      btn.addEventListener("click", () => modal.classList.add("is-open"));
    });
    document.querySelectorAll("[data-close-adq]").forEach((btn) => {
      btn.addEventListener("click", () => modal.classList.remove("is-open"));
    });
    modal.addEventListener("click", (e) => { if (e.target === modal) modal.classList.remove("is-open"); });
    document.querySelectorAll("[data-cia]").forEach((r) => {
      r.addEventListener("change", () => {
        document.getElementById("cia-other").classList.toggle("is-on", r.dataset.cia === "otra" && r.checked);
      });
    });
    function pushToast(kind, msg) {
      const stack = document.getElementById("toast-stack");
      const t = document.createElement("div");
      t.className = kind === "ok" ? "toast toast-ok" : "toast toast-err";
      t.textContent = msg;
      stack.appendChild(t);
      setTimeout(() => t.remove(), 3200);
    }
    document.getElementById("adq-form").addEventListener("submit", () => {
      const cost = document.getElementById("adq-cost").value.trim();
      const price = document.getElementById("adq-price").value.trim();
      const stock = document.getElementById("adq-stock").value.trim();
      if (!cost || !price) {
        document.getElementById("adq-status").textContent = "Costo y Precio son obligatorios (sin datos).";
        document.getElementById("adq-status").className = "form-status err";
        pushToast("err", "Costo y Precio inicial sugerido son obligatorios (sin datos).");
        return;
      }
      if (!stock) { pushToast("err", "El No. de stock es obligatorio."); return; }
      if (EXISTING_STOCK.has(stock.toUpperCase())) {
        pushToast("err", "Ese No. de stock (" + stock.toUpperCase() + ") ya existe. Elige otro.");
        return;
      }
      pushToast("ok", "Registrado " + stock.toUpperCase());
      setTimeout(() => modal.classList.remove("is-open"), 900);
    });
    document.getElementById("btn-save-venta")?.addEventListener("click", () => pushToast("ok", "Venta registrada (vista previa)."));
    (function setupCobranza() {
      const money = (n) => "$" + Math.round(n).toLocaleString("es-MX");
      const fmtDate = (iso) => {
        const [y,m,d] = iso.split("-").map(Number);
        const months = ["ene","feb","mar","abr","may","jun","jul","ago","sep","oct","nov","dic"];
        return String(d).padStart(2,"0") + " " + months[m-1] + " " + y;
      };
      const btn = document.getElementById("btn-save-cobranza");
      if (!btn) return;
      btn.addEventListener("click", () => {
        const sel = document.getElementById("cob-credit");
        const opt = sel?.selectedOptions?.[0];
        const amount = Number(document.getElementById("cob-amount")?.value);
        const fecha = document.getElementById("cob-fecha")?.value || new Date().toISOString().slice(0,10);
        const status = document.getElementById("cob-status");
        if (!opt || !opt.value) {
          pushToast("err", "Selecciona una cuenta / acreedor.");
          if (status) { status.textContent = "Selecciona una cuenta."; status.className = "form-status err"; }
          return;
        }
        if (!Number.isFinite(amount) || amount <= 0) {
          pushToast("err", "La cantidad / pagado es obligatoria.");
          if (status) { status.textContent = "Cantidad obligatoria."; status.className = "form-status err"; }
          return;
        }
        let bal = Number(opt.dataset.balance || 0);
        if (amount > bal + 0.01) {
          pushToast("err", "El monto supera lo que falta liquidar (" + money(bal) + ").");
          if (status) { status.textContent = "Monto supera el saldo."; status.className = "form-status err"; }
          return;
        }
        bal = Math.max(0, bal - amount);
        opt.dataset.balance = String(bal);
        const name = opt.dataset.name || "Cliente";
        const stock = opt.dataset.stock || "";
        opt.textContent = name + " — " + stock + " (faltan " + money(bal) + ")";
        const list = document.getElementById("cob-list");
        if (list) {
          const li = document.createElement("li");
          li.innerHTML = "<span>" + fmtDate(fecha) + " · " + name + " · " + stock + "</span><span class=\\"money-pos\\">" + money(amount) + "</span>";
          list.insertBefore(li, list.firstChild);
        }
        const kpiRec = document.getElementById("kpi-receivable");
        const kpiOpen = document.getElementById("kpi-credit-open");
        const homeRec = document.getElementById("home-receivable");
        if (kpiRec) kpiRec.textContent = money(bal);
        if (homeRec) homeRec.textContent = money(bal);
        if (bal <= 0) {
          if (kpiOpen) kpiOpen.textContent = "0";
          opt.disabled = true;
          pushToast("ok", "Cobranza registrada: " + money(amount) + " · " + name + " · " + stock + " (liquidado).");
          if (status) { status.textContent = "Liquidado."; status.className = "form-status ok"; }
        } else {
          pushToast("ok", "Cobranza registrada: " + money(amount) + " · " + name + " · " + stock + ".");
          if (status) { status.textContent = "Registrado " + money(amount); status.className = "form-status ok"; }
        }
        const amtEl = document.getElementById("cob-amount");
        if (amtEl) amtEl.value = "";
      });
    })();
    document.querySelectorAll("[data-open-adq]").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.getElementById("adq-fecha").value = new Date().toISOString().slice(0, 10);
      });
    });
    function refreshAdqMargin() {
      const c = Number(document.getElementById("adq-cost").value);
      const p = Number(document.getElementById("adq-price").value);
      const el = document.getElementById("adq-margin");
      if (!Number.isFinite(c) || !Number.isFinite(p) || document.getElementById("adq-cost").value.trim() === "" || document.getElementById("adq-price").value.trim() === "") {
        el.value = "—"; return;
      }
      const m = p - c;
      const pct = p > 0 ? Math.round((m / p) * 1000) / 10 : null;
      el.value = "$" + Math.round(m).toLocaleString("es-MX") + (pct != null ? " (" + pct + "%)" : "");
    }
    document.getElementById("adq-cost").addEventListener("input", refreshAdqMargin);
    document.getElementById("adq-price").addEventListener("input", refreshAdqMargin);
    const filterBar = document.getElementById("filter-bar");
    document.getElementById("btn-filtrar")?.addEventListener("click", () => { filterBar.hidden = !filterBar.hidden; });
    function applyStockFilter() {
      const est = document.getElementById("filter-estado")?.value || "all";
      const mar = document.getElementById("filter-marca")?.value || "all";
      document.querySelectorAll("#stock-table tbody tr").forEach((tr) => {
        const okE = est === "all" || tr.dataset.estado === est;
        const okM = mar === "all" || tr.dataset.marca === mar;
        tr.style.display = okE && okM ? "" : "none";
      });
    }
    document.getElementById("filter-estado")?.addEventListener("change", applyStockFilter);
    document.getElementById("filter-marca")?.addEventListener("change", applyStockFilter);
  </script>
  <div id="toast-stack" class="toast-stack" aria-live="polite"></div>
</body>
