  <script>

    const EXISTING_STOCK = new Set(["MBC01", "MBC02", "MBC03", "MBC04", "MBC05", "MBC06", "MBC07", "MBC08", "MBC09", "MBC10", "MBC11", "MBC12", "MBC13", "MBC14", "MBC15", "MBC16", "MBC17", "MBC18", "MBC19"]);
    function showView(id) {
      if (!id || id === "login") return;
      document.querySelectorAll(".view").forEach((el) => {
        if (el.id === "view-login") return; // login gated by body.is-logged-*
        el.classList.toggle("is-active", el.id === "view-" + id);
      });
      document.querySelectorAll("[data-nav]").forEach((el) => {
        if (el.classList.contains("site-nav__link")) {
          el.classList.toggle("is-active", el.getAttribute("data-nav") === id);
        }
      });
      try { localStorage.setItem("celumb_last_view_v1", id); } catch (e) {}
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
    document.querySelectorAll("[data-nav]").forEach((el) => {
      el.addEventListener("click", (e) => { e.preventDefault(); showView(el.getAttribute("data-nav")); });
    });
    const modal = document.getElementById("adq-modal");
    document.querySelectorAll("[data-open-adq]").forEach((btn) => {
      btn.addEventListener("click", () => {
        modal.classList.add("is-open");
        document.getElementById("adq-fecha").value = new Date().toISOString().slice(0, 10);
      });
    });
    document.querySelectorAll("[data-close-adq]").forEach((btn) => {
      btn.addEventListener("click", () => modal.classList.remove("is-open"));
    });
    modal.addEventListener("click", (e) => { if (e.target === modal) modal.classList.remove("is-open"); });
    document.querySelectorAll("[data-cia]").forEach((r) => {
      r.addEventListener("change", () => {
        document.getElementById("cia-other").classList.toggle("is-on", r.dataset.cia === "otra" && r.checked);
      });
    });
    function pushToast(kind, msg) {
      const stack = document.getElementById("toast-stack");
      const t = document.createElement("div");
      t.className = kind === "ok" ? "toast toast-ok" : "toast toast-err";
      t.textContent = msg;
      stack.appendChild(t);
      setTimeout(() => t.remove(), 3800);
    }
    function noticeLive(action) {
      pushToast("err", action + " — vista previa estática (simulación local).");
    }
    document.getElementById("adq-form").addEventListener("submit", (e) => {
      e.preventDefault();
      const cost = document.getElementById("adq-cost").value.trim();
      const price = document.getElementById("adq-price").value.trim();
      const stock = document.getElementById("adq-stock").value.trim();
      if (!cost || !price) {
        pushToast("err", "Costo y Precio inicial sugerido son obligatorios (sin datos).");
        return;
      }
      if (!stock) { pushToast("err", "El No. de stock es obligatorio."); return; }
      if (EXISTING_STOCK.has(stock.toUpperCase())) {
        pushToast("err", "Ese No. de stock (" + stock.toUpperCase() + ") ya existe. Elige otro.");
        return;
      }
      noticeLive("Adquisición simulada (" + stock.toUpperCase() + ")");
      setTimeout(() => modal.classList.remove("is-open"), 900);
    });
    document.getElementById("btn-save-venta")?.addEventListener("click", () => noticeLive("Venta simulada"));
    (function setupCobranza() {
      const moneyFmt = (n) => "$" + Math.round(n).toLocaleString("es-MX");
      const fmtDate = (iso) => {
        const parts = iso.split("-").map(Number);
        const months = ["ene","feb","mar","abr","may","jun","jul","ago","sep","oct","nov","dic"];
        return String(parts[2]).padStart(2,"0") + " " + months[parts[1]-1] + " " + parts[0];
      };
      let nextId = 100;
      const list = document.getElementById("cob-list");
      const sel = document.getElementById("cob-credit");
      const opt = sel && sel.options && sel.options[0];
      if (!list || !opt) return;

      function sumPaid() {
        let s = 0;
        list.querySelectorAll("li[data-amount]").forEach((li) => {
          s += Number(li.dataset.amount || 0);
        });
        return s;
      }
      function syncAccount() {
        const principal = Number(opt.dataset.principal || 3500);
        const paid = sumPaid();
        const bal = Math.max(0, principal - paid);
        opt.dataset.balance = String(bal);
        const name = opt.dataset.name || "Cliente";
        const stock = opt.dataset.stock || "";
        opt.textContent = name + " — " + stock + " (faltan " + moneyFmt(bal) + ")";
        opt.disabled = bal <= 0;
        const kpiRec = document.getElementById("kpi-receivable");
        const homeRec = document.getElementById("home-receivable");
        if (kpiRec) kpiRec.textContent = moneyFmt(bal);
        if (homeRec) homeRec.textContent = moneyFmt(bal);
        const kpiOpen = document.getElementById("kpi-credit-open");
        if (kpiOpen) kpiOpen.textContent = bal > 0 ? "1" : "0";
        const accPaid = document.getElementById("acc-paid");
        const accBal = document.getElementById("acc-balance");
        const accLiq = document.getElementById("acc-liq");
        if (accPaid) accPaid.textContent = moneyFmt(paid);
        if (accBal) {
          accBal.textContent = moneyFmt(bal);
          accBal.className = bal > 0 ? "money-neg" : "money-pos";
        }
        if (accLiq) {
          accLiq.textContent = bal <= 0 ? "Si" : "No";
          accLiq.className = bal <= 0 ? "badge badge-ok" : "badge badge-sold";
        }
        return bal;
      }
      function renderRow(li) {
        const amount = Number(li.dataset.amount || 0);
        const name = li.dataset.name || "Cliente";
        const stock = li.dataset.stock || "";
        const fecha = li.dataset.date || "";
        li.innerHTML = "";
        const left = document.createElement("span");
        left.textContent = fmtDate(fecha) + " · " + name + " · " + stock;
        const right = document.createElement("span");
        right.className = "cobranza-row__right";
        const money = document.createElement("span");
        money.className = "money-pos";
        money.textContent = moneyFmt(amount);
        const editBtn = document.createElement("button");
        editBtn.type = "button";
        editBtn.className = "btn-link cob-edit";
        editBtn.textContent = "Editar";
        right.appendChild(money);
        right.appendChild(editBtn);
        li.appendChild(left);
        li.appendChild(right);
      }
      function openEdit(li) {
        if (list.querySelector(".cobranza-edit")) return;
        const amount = Number(li.dataset.amount || 0);
        const wrap = document.createElement("div");
        wrap.className = "cobranza-edit";
        wrap.innerHTML =
          '<span class="muted">' + fmtDate(li.dataset.date || "") + " · " + (li.dataset.name || "") + " · " + (li.dataset.stock || "") + "</span>" +
          '<div class="cobranza-edit__form">' +
          '<input type="number" class="cobranza-edit__amount" min="1" value="' + Math.round(amount) + '" />' +
          '<button type="button" class="btn btn-solid btn-compact cob-save">Guardar</button>' +
          '<button type="button" class="btn btn-ghost-light btn-compact cob-cancel">Cancelar</button>' +
          "</div>" +
          '<button type="button" class="btn-link btn-link-danger cob-del">Borrar</button>';
        li.innerHTML = "";
        li.appendChild(wrap);
        wrap.querySelector(".cob-cancel").addEventListener("click", () => { renderRow(li); });
        wrap.querySelector(".cob-save").addEventListener("click", () => {
          const next = Number(wrap.querySelector(".cobranza-edit__amount").value);
          if (!Number.isFinite(next) || next <= 0) { pushToast("err", "La cantidad debe ser mayor a 0."); return; }
          const principal = Number(opt.dataset.principal || 3500);
          const others = sumPaid() - Number(li.dataset.amount || 0);
          if (others + next > principal + 0.01) {
            pushToast("err", "El monto supera el principal (máx. " + moneyFmt(principal - others) + ").");
            return;
          }
          li.dataset.amount = String(next);
          renderRow(li);
          syncAccount();
          noticeLive("Cobranza editada (" + moneyFmt(next) + ")");
        });
        wrap.querySelector(".cob-del").addEventListener("click", () => {
          const delRow = wrap.querySelector(".cobranza-edit__delete");
          if (delRow) return;
          const confirm = document.createElement("div");
          confirm.className = "cobranza-edit__delete";
          confirm.innerHTML =
            '<span class="muted">¿Borrar esta cobranza?</span>' +
            '<button type="button" class="btn btn-danger btn-compact cob-del-yes">Confirmar borrar</button>' +
            '<button type="button" class="btn btn-ghost-light btn-compact cob-del-no">No</button>';
          wrap.appendChild(confirm);
          wrap.querySelector(".cob-del").hidden = true;
          confirm.querySelector(".cob-del-no").addEventListener("click", () => {
            confirm.remove();
            wrap.querySelector(".cob-del").hidden = false;
          });
          confirm.querySelector(".cob-del-yes").addEventListener("click", () => {
            li.remove();
            syncAccount();
            noticeLive("Cobranza eliminada");
          });
        });
      }
      list.addEventListener("click", (e) => {
        const btnEdit = e.target.closest(".cob-edit");
        if (!btnEdit) return;
        const li = btnEdit.closest("li");
        if (li) openEdit(li);
      });

      document.getElementById("btn-save-cobranza")?.addEventListener("click", () => {
        const amount = Number(document.getElementById("cob-amount") && document.getElementById("cob-amount").value);
        const fecha = (document.getElementById("cob-fecha") && document.getElementById("cob-fecha").value) || new Date().toISOString().slice(0,10);
        if (!opt.value) { pushToast("err", "Selecciona una cuenta / acreedor."); return; }
        if (!Number.isFinite(amount) || amount <= 0) { pushToast("err", "La cantidad / pagado es obligatoria."); return; }
        let bal = Number(opt.dataset.balance || 0);
        if (amount > bal + 0.01) { pushToast("err", "El monto supera lo que falta liquidar (" + moneyFmt(bal) + ")."); return; }
        const name = opt.dataset.name || "Cliente";
        const stock = opt.dataset.stock || "";
        const li = document.createElement("li");
        li.dataset.id = String(++nextId);
        li.dataset.amount = String(amount);
        li.dataset.name = name;
        li.dataset.stock = stock;
        li.dataset.date = fecha;
        renderRow(li);
        list.insertBefore(li, list.firstChild);
        syncAccount();
        noticeLive("Cobranza simulada (" + moneyFmt(amount) + ")");
        const amtEl = document.getElementById("cob-amount");
        if (amtEl) amtEl.value = "";
      });
      syncAccount();
    })();
    function refreshAdqMargin() {
      const cRaw = document.getElementById("adq-cost").value.trim();
      const pRaw = document.getElementById("adq-price").value.trim();
      const el = document.getElementById("adq-margin");
      const c = Number(cRaw); const p = Number(pRaw);
      if (cRaw === "" || pRaw === "" || !Number.isFinite(c) || !Number.isFinite(p)) { el.value = "—"; return; }
      const m = p - c;
      const pct = p > 0 ? Math.round((m / p) * 1000) / 10 : null;
      el.value = "$" + Math.round(m).toLocaleString("es-MX") + (pct != null ? " (" + pct + "%)" : "");
    }
    document.getElementById("adq-cost").addEventListener("input", refreshAdqMargin);
    document.getElementById("adq-price").addEventListener("input", refreshAdqMargin);
    const filterBar = document.getElementById("filter-bar");
    document.getElementById("btn-filtrar")?.addEventListener("click", () => { filterBar.hidden = !filterBar.hidden; });

    function applyStockFilter() {
      const est = document.getElementById("filter-estado")?.value || "all";
      const mar = document.getElementById("filter-marca")?.value || "all";
      document.querySelectorAll("#stock-table tbody tr").forEach((tr) => {
        const okE = est === "all" || tr.dataset.estado === est;
        const okM = mar === "all" || tr.dataset.marca === mar;
        tr.style.display = okE && okM ? "" : "none";
      });
    }
    document.getElementById("filter-estado")?.addEventListener("change", applyStockFilter);
    document.getElementById("filter-marca")?.addEventListener("change", applyStockFilter);

    (function setupAdqKind() {
      const phoneIds = [
        "adq-phone-stock-wrap","adq-phone-cost-wrap","adq-phone-price-wrap","adq-phone-margin-wrap",
        "adq-phone-charger-wrap","adq-phone-brand-wrap","adq-phone-model-wrap","adq-phone-imei-wrap",
        "adq-phone-cia-wrap","adq-phone-cond-wrap","adq-phone-ram-wrap","adq-phone-storage-wrap","adq-phone-bat-wrap"
      ];
      const accIds = [
        "adq-acc-codigo-wrap","adq-acc-qty-wrap","adq-acc-desc-wrap",
        "adq-acc-cost-wrap","adq-acc-sug-wrap","adq-acc-max-wrap"
      ];
      function syncKind(kind) {
        const isPhone = kind !== "otro";
        phoneIds.forEach((id) => { const el = document.getElementById(id); if (el) el.hidden = !isPhone; });
        accIds.forEach((id) => { const el = document.getElementById(id); if (el) el.hidden = isPhone; });
