    (function setupLabelGen() {
      const LOGO_SRC = "data:image/png;base64,";
      let logoImg = null;
      function ensureLogo() {
        return new Promise((resolve) => {
          if (logoImg && logoImg.complete) { resolve(logoImg); return; }
          const img = new Image();
          img.onload = () => { logoImg = img; resolve(img); };
          img.onerror = () => resolve(null);
          img.src = LOGO_SRC;
        });
      }

      function moneyPlain(n) {
        const v = Math.round(Number(n) || 0);
        return "$" + v.toLocaleString("es-MX").replace(/,/g, ",");
      }
      // Prefer no-grouping for label like $4800
      function moneyLabel(n) {
        return "$" + Math.round(Number(n) || 0).toLocaleString("en-US");
      }
      function fmtStorage(s) {
        s = String(s || "").trim();
        if (!s || s === "—") return "";
        if (/gb|tb/i.test(s)) return s.toUpperCase().replace(/\s+/g, " ");
        if (/^\d+$/.test(s)) return s + " GB";
        return s;
      }
      function fmtRam(s) {
        s = String(s || "").trim();
        if (!s || s === "—") return "";
        return s;
      }

      function roundRect(ctx, x, y, w, h, r) {
        const rr = Math.min(r, w/2, h/2);
        ctx.beginPath();
        ctx.moveTo(x+rr, y);
        ctx.arcTo(x+w, y, x+w, y+h, rr);
        ctx.arcTo(x+w, y+h, x, y+h, rr);
        ctx.arcTo(x, y+h, x, y, rr);
        ctx.arcTo(x, y, x+w, y, rr);
        ctx.closePath();
      }

      function drawBattery(ctx, x, y, w, h) {
        ctx.fillStyle = "#28af55";
        roundRect(ctx, x, y, w, h, 3);
        ctx.fill();
        ctx.fillRect(x+w, y+h*0.25, 4, h*0.5);
        // bolt
        ctx.fillStyle = "#fff";
        ctx.beginPath();
        const cx = x + w*0.48, cy = y + h*0.5;
        ctx.moveTo(cx+2, y+2);
        ctx.lineTo(cx-4, cy+1);
        ctx.lineTo(cx+1, cy+1);
        ctx.lineTo(cx-2, y+h-2);
        ctx.lineTo(cx+5, cy-1);
        ctx.lineTo(cx, cy-1);
        ctx.closePath();
        ctx.fill();
      }

      async function generateLabel(tr) {
        const W = 480, H = 240; // 40×20 mm @ 12 px/mm
        const canvas = document.createElement("canvas");
        canvas.width = W; canvas.height = H;
        const ctx = canvas.getContext("2d");
        // transparent outside, white rounded card
        ctx.clearRect(0,0,W,H);
        ctx.fillStyle = "#ffffff";
        roundRect(ctx, 0, 0, W, H, 18);
        ctx.fill();

        const model = (tr.dataset.model || "").trim() || "Equipo";
        // Prefer model alone; if brand+model and brand duplicated in model, use model
        const brand = (tr.dataset.brand || "").trim();
        let modelShown = model;
        if (brand && !model.toLowerCase().includes(brand.toLowerCase().slice(0,4))) {
          // keep model as primary (ref shows "iPhone 13" without separate brand line)
          modelShown = model;
        }
        const stock = (tr.dataset.stock || "").trim();
        const storage = fmtStorage(tr.dataset.storage);
        const ram = fmtRam(tr.dataset.ram);
        const batRaw = String(tr.dataset.battery || "").trim();
        const battery = batRaw && batRaw !== "—" ? batRaw.replace(/%/g,"").trim() : "";
        const price = moneyLabel(tr.dataset.price);

        const pad = 8;
        const leftMax = W * 0.62;
        ctx.fillStyle = "#121212";
        ctx.textBaseline = "top";

        // Model — fill top-left (largest text)
        let modelSize = 72;
        ctx.font = "700 " + modelSize + "px 'Noto Serif', 'Times New Roman', Times, serif";
        while (modelSize > 40 && ctx.measureText(modelShown).width > leftMax - pad) {
          modelSize -= 2;
          ctx.font = "700 " + modelSize + "px 'Noto Serif', 'Times New Roman', Times, serif";
        }
        ctx.fillText(modelShown, pad, 4);

        // Stock — tight under model, large
        let stockSize = Math.max(34, Math.round(modelSize * 0.58));
        ctx.font = "600 " + stockSize + "px 'Noto Serif', 'Times New Roman', Times, serif";
        const stockY = 4 + modelSize - 2;
        ctx.fillText(stock, pad, stockY);

        // Logo right — leave bottom clear for price
        const img = await ensureLogo();
        if (img) {
          let logoH = 150;
          let logoW = img.width * (logoH / img.height);
          if (logoW > W * 0.38) {
            logoW = W * 0.38;
            logoH = img.height * (logoW / img.width);
          }
          ctx.drawImage(img, W - logoW - 4, 4, logoW, logoH);
        }

        // Bottom band: RAM / storage / battery / price — fill height
        const priceSize = 62;
        const specSize = 40;
        const batIconW = 40, batIconH = 22;
        const bottomY = H - priceSize - 6;
        let midY = stockY + stockSize + 6;
        // If room, place RAM between stock and bottom specs
        if (ram) {
          const ramLabel = ram.match(/ram/i) ? ram : (ram + " RAM");
          ctx.fillStyle = "#121212";
          ctx.font = "600 34px 'Noto Serif', 'Times New Roman', Times, serif";
          ctx.fillText(ramLabel, pad, Math.min(midY, bottomY - 44));
        }
        let sx = pad;
        ctx.font = "600 " + specSize + "px 'Noto Serif', 'Times New Roman', Times, serif";
        ctx.fillStyle = "#121212";
        if (storage) {
          ctx.fillText(storage, sx, bottomY);
          sx += ctx.measureText(storage).width + 10;
        }
        if (battery) {
          drawBattery(ctx, sx, bottomY + Math.round((specSize - batIconH) / 2) + 2, batIconW, batIconH);
          sx += batIconW + 8;
          ctx.fillStyle = "#121212";
          ctx.fillText(battery + " %", sx, bottomY);
        }

        // Price — largest with model
        ctx.fillStyle = "#121212";
        let pSize = priceSize;
        ctx.font = "700 " + pSize + "px 'Noto Serif', 'Times New Roman', Times, serif";
        let pw = ctx.measureText(price).width;
        while (pSize > 40 && pw > W * 0.48) {
          pSize -= 2;
          ctx.font = "700 " + pSize + "px 'Noto Serif', 'Times New Roman', Times, serif";
          pw = ctx.measureText(price).width;
        }
        ctx.fillText(price, W - pw - pad, H - pSize - 4);

        const filename = (stock || "stock") + ".png";
        canvas.toBlob((blob) => {
          if (!blob) { pushToast("err", "No se pudo generar la etiqueta."); return; }
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = url;
          a.download = filename;
          document.body.appendChild(a);
          a.click();
          a.remove();
          setTimeout(() => URL.revokeObjectURL(url), 2000);
          noticeLive("Etiqueta 40×20 mm (" + stock + ")");
        }, "image/png");
      }

      document.addEventListener("click", (e) => {
        const btn = e.target.closest(".stock-label");
        if (!btn) return;
        const tr = btn.closest("tr");
        if (!tr || tr.dataset.kind === "acc") return;
        generateLabel(tr).catch((err) => {
          console.error(err);
          pushToast("err", "No se pudo generar la etiqueta.");
        });
      });

      // preload
      ensureLogo();
    })();


