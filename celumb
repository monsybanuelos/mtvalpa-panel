        writeSession({ username: user, role: u.role });
        const start = user === "Ventas" ? "inventario" : "inicio";
        writeLastView(start);
        applyAuth({ restoreView: true, forceView: start });
        noticeLive("Sesión: " + user);
      }
      function doLogout() {
        writeSession(null);
        applyAuth();
        const pass = document.getElementById("login-pass");
        if (pass) pass.value = "";
        noticeLive("Sesión cerrada");
      }
      document.getElementById("btn-login")?.addEventListener("click", doLogin);
      document.getElementById("login-pass")?.addEventListener("keydown", (e) => {
        if (e.key === "Enter") doLogin();
      });
      document.getElementById("btn-logout")?.addEventListener("click", doLogout);
      // Gate navigation while logged out; persist last section while logged in
      document.querySelectorAll("[data-nav], [data-open-adq]").forEach((el) => {
        el.addEventListener("click", (e) => {
          const s = readSession();
          if (!s) {
            e.preventDefault();
            e.stopPropagation();
            applyAuth();
            return;
          }
          const nav = el.getAttribute("data-nav");
          if (nav) {
            if (!allowedView(s.username, nav)) {
              e.preventDefault();
              e.stopPropagation();
              if (typeof showView === "function") showView("inventario");
              writeLastView("inventario");
              return;
            }
            writeLastView(nav);
          }
        }, true);
      });
      // Restore session + last open section on load (reload keeps you logged in)
      applyAuth({ restoreView: true });
    })();


    (function setupVentasInventory() {
      function gradoFromCondition(c) {
        c = String(c || "");
        if (/^AA\b/i.test(c) || /AA Nuevo/i.test(c)) return "AA";
        if (/^A\b/i.test(c) || /A Bueno/i.test(c)) return "A";
        if (/^B\b/i.test(c) || /B Regular/i.test(c)) return "B";
        if (/^C\b/i.test(c) || /C Con/i.test(c)) return "C";
        return c || "—";
      }
      function fmtStorageGB(s) {
        s = String(s || "").trim();
        if (!s || s === "—") return "";
        const m = s.match(/(\d+)/);
        return m ? m[1] : s.replace(/\s*GB/i, "");
      }
      function moneyPlain(n) {
        return Math.round(Number(n) || 0).toLocaleString("en-US");
      }
      function buildPubText(tr) {
        const model = (tr.dataset.model || "").trim() || "Equipo";
        const price = moneyPlain(tr.dataset.price);
        const gb = fmtStorageGB(tr.dataset.storage);
        const carrier = (tr.dataset.carrier || "").trim();
        const ciaLine = /^liberado$/i.test(carrier)
          ? "Libre a cualquier compañía"
          : (carrier || "—");
        const grado = gradoFromCondition(tr.dataset.condition);
        const bat = String(tr.dataset.battery || "").replace(/%/g, "").trim();
        const ram = String(tr.dataset.ram || "").trim();
        let lines = [
          "🔸🔸" + model + " 🔸🔸",
          "💲" + price
        ];
        if (gb) lines.push("▪" + gb + " GB");
        lines.push("▪" + ciaLine);
        lines.push("▪Grado " + grado);
        if (bat) lines.push("▪Batería " + bat + "%");
        if (ram && ram !== "—") lines.push("▪RAM " + ram);
        return lines.join("\n");
      }
      async function copyText(text) {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch (e) {
          const ta = document.createElement("textarea");
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand("copy"); } catch (err) {}
          ta.remove();
          return true;
        }
      }
      const modal = document.getElementById("pub-modal");
      const pubTextEl = document.getElementById("pub-text");
      function openPub(text) {
        if (pubTextEl) pubTextEl.textContent = text;
        modal?.classList.add("is-open");
      }
      function closePub() { modal?.classList.remove("is-open"); }
      modal?.querySelectorAll("[data-close-pub]").forEach((b) => b.addEventListener("click", closePub));
      modal?.addEventListener("click", (e) => { if (e.target === modal) closePub(); });
      document.getElementById("btn-pub-copy")?.addEventListener("click", async () => {
        const t = pubTextEl?.textContent || "";
        await copyText(t);
        noticeLive("Texto copiado");
      });

      document.addEventListener("click", async (e) => {
        const dl = e.target.closest(".btn-dl-foto");
        if (dl) {
          if (dl.disabled) return;
          const tr = dl.closest("tr");
          if (!tr) return;
          const which = dl.getAttribute("data-which") === "2" ? "2" : "1";
          const src = which === "2" ? tr.dataset.photo2 : tr.dataset.photo1;
          if (!src) { pushToast("err", "No hay foto " + which + " para este equipo."); return; }
          const stock = tr.dataset.stock || "foto";
          const a = document.createElement("a");
          a.href = src;
          a.download = stock + "-foto" + which + ".png";
          document.body.appendChild(a);
          a.click();
          a.remove();
          noticeLive("Descarga foto " + which + " (" + stock + ")");
          return;
        }
        const pub = e.target.closest(".btn-gen-pub");
        if (pub) {
          const tr = pub.closest("tr");
          if (!tr) return;
          const text = buildPubText(tr);
          await copyText(text);
          openPub(text);
          noticeLive("Publicación copiada");
        }
      });
    })();

  </script>
  <div id="toast-stack" class="toast-stack" aria-live="polite"></div>
</body>
