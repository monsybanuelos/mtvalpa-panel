# CeluMB — Hostinger Node / local cloud
# Copy to .env.local or paste into hPanel → Environment variables (NAMES only here).

# Required for Supabase (shared cloud DB)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Optional aliases (some dashboards show these names)
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PASSWORD=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=

# App
CELUMB_PUBLIC_URL=https://celumb.mtvalpa.com
CELUMB_AUTH_SECRET=
PORT=3000
# Optional: absolute path to secrets file (agent VM / deploy helper)
# CELUMB_SECRETS=
